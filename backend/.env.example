# ---- Flask ----
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET_KEY=change-this-to-a-different-long-random-string

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=placementprep_ai
DB_USER=root
DB_PASSWORD=your-mysql-password

# ---- Uploads ----
MAX_UPLOAD_MB=5

# ---- CORS ----
FRONTEND_ORIGIN=http://localhost:5173

# ---- AI / LLM (optional) ----
# If ANTHROPIC_API_KEY is left blank, the app automatically falls back
# to rule-based resume analysis and a local interview question bank.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
